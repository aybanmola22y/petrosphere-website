# Copy to .env.local — do not commit secrets.

# ─── Hostinger media (CSR images & testimonial videos) ───
# local = dev only (public/uploads/). http = PHP on Hostinger (recommended). ftp = FTP upload.
# HOSTINGER_MEDIA_MODE=http
# HOSTINGER_MEDIA_BASE_URL=https://petrosphere.com.ph
# HOSTINGER_UPLOAD_URL=https://petrosphere.com.ph/_cms/upload.php
# HOSTINGER_UPLOAD_SECRET=

# FTP alternative (if not using PHP):
# HOSTINGER_FTP_HOST=ftp.petrosphere.com.ph
# HOSTINGER_FTP_USER=
# HOSTINGER_FTP_PASSWORD=
# HOSTINGER_FTP_REMOTE_DIR=/public_html/uploads
# HOSTINGER_FTP_SECURE=true

# ─── Cloudflare Turnstile (admin login bot protection) ───
# Create keys: Cloudflare Dashboard → Turnstile → Add site → hostname: petrosphere.petros-global.com
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
# Dev test keys (always pass): site 1x00000000000000000000AA / secret 1x0000000000000000000000000000000AA
